# Absolute public API origin used by generate-sitemap.mjs during production build.
SITEMAP_API_URL=https://api.smartagency-ye.com/api

# Frontend API URL used by the browser bundle. A relative path is valid here.
VITE_API_URL=/api

# Optional custom R2 public origin. Must match the backend R2_PUBLIC_DOMAIN.
# Native *.r2.dev image URLs are recognized automatically.
VITE_IMAGE_ORIGIN=

# CI/Docker commit identifier exposed through /build-info.json.
SOURCE_COMMIT=
